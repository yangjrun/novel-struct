# 留空则使用本地 PGlite 文件数据库，路径为 NOVELSTRUCT_DATA_DIR/novelstruct.pglite
DATABASE_URL=
NOVELSTRUCT_DATA_DIR=./data

# OpenAI 兼容接口，供 --attributor llm 使用
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# 以下可选。请求默认以流式（SSE）接收，只要模型还在输出就不算超时。
# 首字节之前或两个数据块之间允许的最长静默，毫秒；超过则重试该次请求。默认 120000
LLM_IDLE_TIMEOUT_MS=
# 单次请求的总时长上限，毫秒；超过不重试。默认 900000（15 分钟）
LLM_TIMEOUT_MS=
# 服务端不支持流式时设为 false
LLM_STREAM=
# 限制模型输出 token 数；留空用服务端默认
LLM_MAX_TOKENS=
# 模型单价，每百万 token，用于估算解析成本；两项都填才启用，币种只是显示标签
LLM_PRICE_INPUT=
LLM_PRICE_OUTPUT=
LLM_PRICE_CURRENCY=USD

# Web 管理界面的 API 服务（pnpm api）
PORT=3100
# 留空默认只监听本机；监听内网/公网地址前必须配置 API_TOKEN
HOST=
API_TOKEN=
# 允许跨域调用 API 的来源，逗号分隔；默认是 Vite 开发服务器
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 设置后 API 同时托管构建好的前端（pnpm web:build 输出目录）
NOVELSTRUCT_WEB_DIST=

# 解析任务队列。留空则用 API 进程内的内存队列（重启丢失排队任务）；
# 设置 Redis 地址后改用 BullMQ，任务与逐章进度存在 Redis 里，重启后继续
REDIS_URL=
# Redis 键前缀，多套部署共用一个 Redis 时区分用
QUEUE_PREFIX=novelstruct
# 是否在 API 进程内运行 worker，默认 true；启动了独立的 pnpm worker 时设为 false
QUEUE_INLINE_WORKER=
# 一个 worker 进程同时处理的任务数，默认 1。每个任务持有所在书的锁，同一本书不会被并行解析
QUEUE_CONCURRENCY=

# 场景语义检索：兼容 OpenAI 的 embedding 接口，返回 1536 维向量
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# 可选 WeKnora 适配器。API key 使用 X-API-Key，URL 指向服务根路径（不含 /api/v1）
WEKNORA_BASE_URL=
WEKNORA_API_KEY=
