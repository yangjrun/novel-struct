# 留空则使用本地 PGlite 文件数据库，路径为 NOVELSTRUCT_DATA_DIR/novelstruct.pglite
DATABASE_URL=
NOVELSTRUCT_DATA_DIR=./data

# OpenAI 兼容接口，供 --attributor llm 使用
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# 以下可选。请求默认以流式（SSE）接收，只要模型还在输出就不算超时。
# 首字节之前或两个数据块之间允许的最长静默，毫秒；超过则重试该次请求。默认 120000
LLM_IDLE_TIMEOUT_MS=
# 单次请求的总时长上限，毫秒；超过不重试。默认 900000（15 分钟）
LLM_TIMEOUT_MS=
# 服务端不支持流式时设为 false
LLM_STREAM=
# 限制模型输出 token 数；留空用服务端默认
LLM_MAX_TOKENS=

# Web 管理界面的 API 服务（pnpm api）
PORT=3100
# 留空监听所有地址；只想本机访问可设 127.0.0.1
HOST=
# 允许跨域调用 API 的来源，逗号分隔；默认是 Vite 开发服务器
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 设置后 API 同时托管构建好的前端（pnpm web:build 输出目录）
NOVELSTRUCT_WEB_DIST=
